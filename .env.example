# ========================================================
# TiDB Cloud Configuration (MySQL 8.0 Compatible)
# Course: DIT204 Information System Project Management
# ========================================================

# Host address provided by TiDB Cloud (e.g. gateway01.us-east-1.prod.aws.tidbcloud.com)
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com

# Standard TiDB Port is 4000
TIDB_PORT=4000

# TiDB Username (e.g. xxxxxx.root)
TIDB_USER=your_tidb_username.root

# TiDB Password
TIDB_PASSWORD=your_tidb_password

# Database Name
TIDB_DATABASE=lost_and_found

# Enable SSL for TiDB Cloud Serverless (recommended true)
TIDB_ENABLE_SSL=true

# Alternative direct connection URL
# DATABASE_URL=mysql://your_user:your_password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/lost_and_found?ssl={"rejectUnauthorized":true}

